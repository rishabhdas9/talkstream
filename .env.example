# Docker Compose settings. Copy this file to .env in the repository root.
# Public mode refuses to start until every value is real; deploy/backup.md covers recovery.
TALKSTREAM_PUBLIC_ORIGIN=https://talkstream.example
TALKSTREAM_HTTP_PORT=8080
TALKSTREAM_ADMIN_EMAILS=owner@example.com
# A sender on a domain verified in Resend; onboarding@resend.dev only reaches the account owner.
TALKSTREAM_RESEND_FROM=Talkstream <login@talkstream.example>
# limited_vps (₹500/month variable API cap) or owner_hosted; must match deploy/config/runtime-policy.json.
TALKSTREAM_RUNTIME_PROFILE=limited_vps
# Owner-controlled directory outside the database backups, for the deletion journal.
TALKSTREAM_RECOVERY_DIR=/mnt/talkstream-recovery

# Secrets are files, one value each, in deploy/secrets/ (git-ignored):
#   jwt_secret                 openssl rand -hex 32
#   credential_encryption_key  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   backup_encryption_key      openssl rand -hex 32 (different from the credential key)
#   sarvam_api_key, exa_api_key, resend_api_key
# Also place the owner-confirmed rate card at deploy/config/rate-card.json.

# Optional knowledge-base RAG add-on. Users can save their own OpenAI or Gemini key; a
# platform OpenAI key is only needed for a shared default.
KNOWLEDGE_RAG_ENABLED=false
TALKSTREAM_OPENAI_API_KEY_FILE=./deploy/secrets/openai_api_key.empty
