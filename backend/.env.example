# Application
APP_ENV=development
# One-button local sign-in as "user"; never set on a hosted server.
DEV_LOGIN=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RUNTIME_PROFILE=owner_hosted
BACKEND_WORKERS=1
# Zero disables paid evaluation calls. A live-run cap is explicitly approved separately.
LIVE_EVALUATION_CAP_MICRO_INR=0

# Public mode also requires real email delivery, one HTTPS origin and these local inputs.
PUBLIC_ORIGIN=
ADMIN_EMAILS=
CREDENTIAL_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
# Deletion journal on an owner-controlled mount outside database backups (deploy/backup.md).
RECOVERY_JOURNAL_FILE=
POLICY_FILE=
# Optional strict local override; blank uses the required bundled v1 content policy.
CONTENT_POLICY_FILE=
# Voice admission needs a current qualified rate card in every environment.
# config/rates/example.json is synthetic and deliberately cannot enable live calls.
RATE_CARD_FILE=

# External services - leave empty to use the documented development fallbacks
SARVAM_CHAT_BASE_URL=https://api.sarvam.ai/v1
# https://dashboard.sarvam.ai (STT + LLM + TTS)
SARVAM_API_KEY=
# https://dashboard.exa.ai (web_search tool)
EXA_API_KEY=
EXA_SEARCH_TIMEOUT_SECONDS=8
# https://console.deepgram.com (optional S22 recognition experiment; STT_MODEL=nova-3, STT_LANGUAGE_CODE=multi)
DEEPGRAM_API_KEY=
# https://console.groq.com (optional S23 utterance recognition; STT_MODEL=whisper-large-v3-turbo,
# ENDPOINTING_STRATEGY=local_vad)
GROQ_API_KEY=
# https://play.cartesia.ai (optional S24 synthesis; commercial use needs a paid plan)
CARTESIA_API_KEY=
# Maximum time to wait for a browser-local todo tool_result before returning an error to the model.
CLIENT_TOOL_TIMEOUT_SECONDS=12
# https://resend.com (empty = console OTP)
RESEND_API_KEY=
RESEND_FROM="Talkstream <onboarding@resend.dev>"

# Optional knowledge-base RAG add-on. Disabled means no knowledge routes,
# embedding-provider client, or vector-database client is initialized.
KNOWLEDGE_RAG_ENABLED=false
# vector (baseline) or hybrid (opt-in keyword+vector fusion; see docs/progress/S26.md)
KNOWLEDGE_RETRIEVAL_MODE=vector
# Used only when the add-on is enabled; never sent to the browser.
OPENAI_API_KEY=
QDRANT_URL=http://127.0.0.1:6333

# Authentication - generate with: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=86400
JWT_ISSUER=talkstream
JWT_AUDIENCE=talkstream-api
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5

# Persistence and billing
DATABASE_URL=sqlite+aiosqlite:///./voiceagent.db
DATABASE_ECHO=false
PRICE_PER_MINUTE_PAISE=200
LOW_BALANCE_WARN_PAISE=100
MIN_VOICE_BALANCE_PAISE=1
# Billing runs outside the audio path. Default one-second ticks provide prompt enforcement.
BILLING_TICK_SECONDS=1
# Mock-only selectable recharge amounts. The 5-paise option supports cutoff verification.
MOCK_RECHARGE_AMOUNTS_PAISE=5,500,1000,2500,5000

# Voice endpointing. local_vad is the production default and drops silence before
# the Sarvam boundary. sarvam forwards all audio, including silence, and exists
# only for endpoint-latency A/B benchmarking and debugging.
ENDPOINTING_STRATEGY=local_vad
VAD_PROVIDER=silero
# Empty uses the bundled Silero ONNX model. Set to an absolute model path to override.
VAD_MODEL_PATH=
VAD_END_SILENCE_MS=650
VAD_BARGE_IN_MS=300
VAD_PRE_ROLL_MS=160
VAD_SPEECH_THRESHOLD=0.5
VAD_PRE_ROLL_THRESHOLD=0.2
VAD_ENERGY_THRESHOLD=500
METRICS_HUD=true
# Perceived-latency v1. Disable either flag as an independent rollout kill switch.
PHRASE_CHUNKING_ENABLED=true
# Enable only after adding a licensed Talkstream cue recording.
RESPONSE_CUES_ENABLED=false
RESPONSE_CUE_DELAY_MS=350
# Number of complete turns to leave between cues (1 = at most every other turn).
RESPONSE_CUE_COOLDOWN_TURNS=1
LLM_MODEL=sarvam-105b
LLM_REASONING_EFFORT=
# sarvam_legacy (default), sarvam_realtime, deepgram or groq; the streaming transports need
# ENDPOINTING_STRATEGY=sarvam (provider endpointing), groq needs local_vad.
STT_TRANSPORT=sarvam_legacy
# Opt-in realtime candidate settings are in evals/profiles/sarvam-realtime.json.
# Live qualification is required before promoting it to a public default.
STT_MODEL=saaras:v3
STT_LANGUAGE_CODE=unknown
STT_INPUT_AUDIO_CODEC=pcm_s16le
STT_AUDIO_ENCODING=audio/wav
# sarvam (default) or cartesia (optional S24: TTS_MODEL=sonic-3.6, TTS_SPEAKER=<voice UUID>)
TTS_PROVIDER=sarvam
# bulbul:v4-flash (default since S20) needs a persona speaker; bulbul:v3 uses names such as shubh
TTS_MODEL=bulbul:v4-flash
TTS_SAMPLE_RATE_HZ=22050
TTS_SPEAKER=roopa_en_conversational
TTS_HINDI_SPEAKER=roopa_hi_conversational
TTS_LANGUAGE_CODE=en-IN
TTS_PACE=1.05
TTS_OUTPUT_AUDIO_CODEC=linear16

# Embeddings: require an explicit supported endpoint pin and deny data collection.
# A current qualified rate card and live release qualification are separate gates.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_FILE=
OPENROUTER_EMBEDDING_PROVIDER=
OPENROUTER_EMBEDDING_DATA_COLLECTION=
# CREDENTIAL_ENCRYPTION_KEY must be a fresh Fernet.generate_key() value.
# Keep its master key outside SQLite; losing it makes stored API keys unreadable.
